{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"rootDir": "src",
		"outDir": "dist",
		"paths": {
			"@elizaos/core": ["../../eliza-upstream/packages/core/src/index.node.ts"],
			"@elizaos/core/*": ["../../eliza-upstream/packages/core/src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
