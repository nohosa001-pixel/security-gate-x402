# ==============================================================================
# Environment Configuration for agent-security-gate-x402
# ==============================================================================

# Server Environment: 'development' (sandbox free mode) or 'production'
ENV=development

# Gate Oracle Signer Private Key (for EIP-191 and EIP-712 attestations)
# Replace with your secure EVM private key in production
GATE_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d

# Settlement Wallet Address on Polygon network receiving $0.002 USDC
SERVER_WALLET_ADDRESS=0x255F9991233f86B29dB847c8d5b8CB9915e80dCf
GATE_PAY_TO_ADDRESS=0x255F9991233f86B29dB847c8d5b8CB9915e80dCf

# Blockchain Network & Primary ID (137 = Polygon Mainnet, 8453 = Base, 42161 = Arbitrum)
NETWORK=polygon
POLYGON_CHAIN_ID=137

# Polygon Native USDC Contract (0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359)
USDC_CONTRACT_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# x402 Facilitator Verification Endpoint
FACILITATOR_URL=https://facilitator.x402.org/v2/verify

# Port to listen on (Default: 8080)
PORT=8080

# Optional: Extra comma-separated list of blocked EVM addresses for OFAC compliance
BLOCKED_ADDRESSES=
